# --- Model access -----------------------------------------------------------
# Either export ANTHROPIC_API_KEY, or run `ant auth login` and leave this unset:
# the SDK resolves an OAuth profile automatically.
ANTHROPIC_API_KEY=

# --- Datastore --------------------------------------------------------------
DATABASE_URL=postgres://agentcorp:agentcorp@localhost:5433/agentcorp

# --- Company controls -------------------------------------------------------
# Hard ceiling on total model spend per calendar month, in USD. All loops halt
# when the ledger crosses this. There is no override flag by design.
AGENTCORP_MONTHLY_USD_CAP=200

# Default per-ticket budget when the creating agent does not set one.
AGENTCORP_DEFAULT_TICKET_USD=2.00

# Tickets deeper than this escalate to the CEO instead of decomposing further.
AGENTCORP_MAX_TICKET_DEPTH=3

# Minutes an agent may hold a claimed ticket before the lease expires.
AGENTCORP_LEASE_MINUTES=20

# --- Billing (leave blank until you have a legal entity) --------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
